{
  "name": "bchu-blog-astro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-wordpress.mjs",
    "dev": "pnpm sync && astro dev --host 0.0.0.0",
    "build": "pnpm sync && pnpm test && astro check && astro build && pnpm verify:build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test": "node --experimental-strip-types tests/content.test.ts && node tests/import.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.0",
    "he": "^2.0.0",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/he": "^1.2.3",
    "@types/sanitize-html": "^2.16.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3"
  }
}
